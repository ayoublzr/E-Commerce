# Copier ce fichier en .env et remplir les valeurs. Ne JAMAIS commiter .env.
# Pas de guillemets autour des valeurs (Spring lit ce fichier au format .properties).

# --- Base de données ---
DB_URL=jdbc:mysql://localhost:3306/ecommerce?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=ecomuser
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# --- JWT --- (générer avec : openssl rand -base64 64 | tr -d '\n')
JWT_SECRET=change-me

# --- SMTP (Gmail : utiliser un "mot de passe d'application") ---
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=change-me

# --- URLs ---
APP_VERIFICATION_URL=http://localhost:8087/api/v1/auth/verify
APP_FRONTEND_URL=http://localhost:4200/pages/login
CORS_ALLOWED_ORIGINS=http://localhost:4200